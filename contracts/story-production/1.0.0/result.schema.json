{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "background": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Workspace-scoped immutable asset identifier."
        },
        "checksumSha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 checksum of the downloadable artifact bytes."
        },
        "contentUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Authenticated runtime URL for downloading the artifact."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192,
          "description": "Artifact height in pixels."
        },
        "kind": {
          "type": "string",
          "enum": ["image"]
        },
        "mimeType": {
          "type": "string",
          "enum": ["image/jpeg", "image/png", "image/webp"]
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192,
          "description": "Artifact width in pixels."
        }
      },
      "required": [
        "assetId",
        "checksumSha256",
        "contentUrl",
        "height",
        "kind",
        "mimeType",
        "sizeBytes",
        "width"
      ]
    }
  },
  "required": ["background"]
}
