{
  "CORSRules": [
    {
      "AllowedOrigins": ["https://production.apption.space"],
      "AllowedMethods": ["GET", "HEAD", "PUT"],
      "AllowedHeaders": ["content-type", "range", "x-amz-*"],
      "ExposeHeaders": ["ETag", "Content-Length", "Content-Range", "Accept-Ranges", "x-amz-checksum-sha256"],
      "MaxAgeSeconds": 3600
    }
  ]
}
