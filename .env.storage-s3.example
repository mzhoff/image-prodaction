# Merge these settings into the protected server environment after creating a PRIVATE bucket.
# This is a template, not working credentials. Do not commit the filled file.
S3_ENDPOINT=https://replace-with-your-endpoint.example.invalid
S3_REGION=replace-with-bucket-region
S3_BUCKET=replace-with-private-bucket
S3_ACCESS_KEY_ID=replace-with-bucket-access-key
S3_SECRET_ACCESS_KEY=replace-with-bucket-secret-key
S3_FORCE_PATH_STYLE=true
CHAT_ATTACHMENT_MODEL_DELIVERY=remote-url

# Separate private backup bucket on the SAME S3 endpoint, and ops-only credentials.
# The backup identity must read the source and write the backup; the app does not receive it.
S3_BACKUP_BUCKET=replace-with-backup-bucket
S3_BACKUP_ACCESS_KEY_ID=replace-with-backup-ops-access-key
S3_BACKUP_SECRET_ACCESS_KEY=replace-with-backup-ops-secret-key
